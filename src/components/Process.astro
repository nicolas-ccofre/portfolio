---
const steps = [
  {
    n: "01",
    title: "Descubrimiento",
    text: "Entendemos tu negocio, tus clientes y qué necesitas lograr. Sin esto, ningún diseño funciona.",
  },
  {
    n: "02",
    title: "Diseño",
    text: "Damos forma a la identidad visual y a cada pantalla, pensando siempre en quien la va a usar.",
  },
  {
    n: "03",
    title: "Desarrollo",
    text: "Construimos un sitio rápido, seguro y preparado para aparecer en Google.",
  },
  {
    n: "04",
    title: "Lanzamiento",
    text: "Publicamos, medimos y acompañamos. Tu sitio queda listo para crecer contigo.",
  },
];
---

<section id="proceso" class="px-6 py-24 md:px-10 md:py-36">
  <div class="mx-auto max-w-[1600px]">
    <header class="mb-16 max-w-3xl" data-reveal>
      <p class="eyebrow mb-5 text-accent reveal-item">Nuestro proceso</p>
      <h2 class="display text-[clamp(2.2rem,6vw,6rem)] reveal-item">
        Del primer café<br /><em>al lanzamiento</em>
      </h2>
    </header>

    <div class="divide-y divide-line">
      {
        steps.map((s) => (
          <div
            class="grid grid-cols-1 gap-4 py-8 md:grid-cols-12 md:items-baseline md:gap-8"
            data-reveal
          >
            <span class="display col-span-2 text-3xl text-accent reveal-item md:text-5xl">
              {s.n}
            </span>
            <h3 class="display col-span-4 text-2xl reveal-item md:text-4xl">
              {s.title}
            </h3>
            <p class="col-span-6 max-w-xl text-base leading-relaxed text-ink-soft reveal-item">
              {s.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
