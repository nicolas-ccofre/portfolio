---
import { getCollection } from "astro:content";

const team = await getCollection("team");
---

<section id="equipo" class="px-6 py-24 md:px-10 md:py-36">
  <div class="mx-auto max-w-[1600px]">
    <header class="mb-16 max-w-3xl" data-reveal>
      <p class="eyebrow mb-5 text-muted reveal-item">El equipo</p>
      <h2 class="display text-[clamp(2.2rem,6vw,6rem)] reveal-item">
        Dos personas,<br /><em>una visión</em>
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft reveal-item">
        Tener una página web bien hecha no es un lujo — es la herramienta que te
        permite estar disponible las 24 horas y proyectar la confianza que tu
        negocio merece. Nosotros nos encargamos de todo el proceso.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        team.map((member) => (
          <article
            class="flex flex-col rounded-3xl border border-line bg-paper-2/50 p-8 md:p-10"
            data-reveal
          >
            <div class="mb-6 flex items-center gap-4 reveal-item">
              <span
                class="flex h-14 w-14 items-center justify-center rounded-full text-xl font-semibold text-paper"
                style={`background:${member.data.accent}`}
              >
                {member.data.name.charAt(0)}
              </span>
              <div>
                <h3 class="display text-2xl md:text-3xl">{member.data.name}</h3>
                <span class="text-sm text-muted">{member.data.role}</span>
              </div>
            </div>
            <p class="mb-8 text-base leading-relaxed text-ink-soft reveal-item">
              {member.data.bio}
            </p>
            <ul class="mt-auto flex flex-wrap gap-2 reveal-item">
              {member.data.skills.map((skill) => (
                <li class="rounded-full border border-line px-3 py-1.5 text-xs font-medium text-ink-soft">
                  {skill}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
