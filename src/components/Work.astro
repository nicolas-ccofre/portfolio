---
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);

const filters = [
  { key: "all", label: "Todos" },
  { key: "salud", label: "Salud" },
  { key: "landing", label: "Landing Page" },
];
---

<section id="trabajo" class="px-6 py-24 md:px-10 md:py-36">
  <div class="mx-auto max-w-[1600px]">
    <header
      class="mb-14 flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
      data-reveal
    >
      <div>
        <p class="eyebrow mb-5 text-muted reveal-item">Nuestro trabajo</p>
        <h2 class="display text-[clamp(2rem,5vw,4rem)] reveal-item">
          Diseños <em>que venden</em>
        </h2>
      </div>
      <p class="max-w-sm text-base leading-relaxed text-ink-soft reveal-item">
        Proyectos reales y templates, cada uno adaptable a tu negocio. Explora
        lo que hemos construido.
      </p>
    </header>

    <!-- Filtros -->
    <div class="mb-12 flex flex-wrap gap-3" role="tablist" aria-label="Filtrar proyectos">
      {
        filters.map((f, i) => (
          <button
            class:list={[
              "filter-btn rounded-full border px-5 py-2 text-sm font-medium transition-colors duration-300",
              i === 0
                ? "border-ink bg-ink text-paper"
                : "border-line text-ink-soft hover:border-ink hover:text-ink",
            ]}
            data-filter={f.key}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2" id="workGrid">
      {
        projects.map((p, i) => (
          <article
            class="work-item group"
            data-category={p.data.categoryKey}
            data-reveal
          >
            <a
              href={p.data.url}
              target="_blank"
              rel="noopener"
              class="relative block overflow-hidden rounded-2xl bg-paper-2 reveal-item"
            >
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={p.data.image}
                  alt={p.data.title}
                  loading={i < 2 ? "eager" : "lazy"}
                  class="h-full w-full object-cover object-top transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
                />
              </div>
              <div class="absolute inset-0 flex items-end justify-between bg-gradient-to-t from-ink/60 via-transparent to-transparent p-6 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                <span class="text-sm font-medium text-paper">{p.data.tech}</span>
                <span class="inline-flex items-center gap-2 rounded-full bg-paper px-4 py-2 text-sm font-medium text-ink">
                  Ver sitio →
                </span>
              </div>
            </a>
            <div class="mt-5 flex items-start justify-between gap-4 reveal-item">
              <div>
                <div class="mb-1 flex items-center gap-3">
                  <span class="text-xs font-medium uppercase tracking-wider text-accent">
                    {p.data.category}
                  </span>
                  <span class="text-xs text-muted">{p.data.year}</span>
                </div>
                <h3 class="display text-2xl md:text-3xl">{p.data.title}</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-soft">
                  {p.data.description}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".work-item");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;

      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute("aria-pressed", String(active));
        b.classList.toggle("bg-ink", active);
        b.classList.toggle("text-paper", active);
        b.classList.toggle("border-ink", active);
        b.classList.toggle("border-line", !active);
        b.classList.toggle("text-ink-soft", !active);
      });

      items.forEach((item) => {
        const show = filter === "all" || item.dataset.category === filter;
        item.style.display = show ? "" : "none";
      });
    });
  });
</script>
