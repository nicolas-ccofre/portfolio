---
// Enunciado grande con efecto "escritura": las palabras se iluminan con el scroll
const text =
  "StudioPixel es un estudio de diseño web que convierte visitantes en clientes y hace que tu marca brille en cada pantalla.";
const words = text.split(" ");
const emphasis = new Set(["brille", "clientes"]);
---

<section id="manifiesto" class="px-6 py-32 md:px-10 md:py-52">
  <div class="mx-auto max-w-[1500px]">
    <p class="eyebrow mb-10 text-muted">Quiénes somos</p>
    <p
      class="display text-[clamp(1.9rem,5.2vw,5rem)] leading-[1.12]"
      data-words
    >
      {
        words.map((w) => (
          <>
            <span
              class:list={["word", emphasis.has(w) && "italic"]}
              set:text={w}
            />{" "}
          </>
        ))
      }
    </p>
  </div>
</section>
